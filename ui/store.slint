// State shared between Rust and every view. Rust fills the `in` properties
// and handles the callbacks; views read and navigate through this global.

// Install and game lifecycle, shown in the bottom bar.
export enum Screen { installing, error, ready, running }

export enum Page { play, installations, edit, settings }

// A modpack from pack.toml, with display strings filled in by Rust.
export struct PackInfo {
    name: string,
    // e.g. "All the Mods 10 8.6".
    label: string,
    // Modpack version; empty for plain NeoForge.
    version: string,
    minecraft: string,
    neoforge: string,
    // Where its game runs by default, shortened for display.
    game-dir: string,
}

// An installation, mirroring `settings::Profile`.
export struct Profile {
    name: string,
    // Index into `Store.packs`.
    pack: int,
    ram-gb: int,
    // 0 means the game picks the window size.
    width: int,
    height: int,
    fullscreen: bool,
    jvm-args: string,
    // Empty means the bundled Java runtime.
    java-path: string,
    // Empty means the pack's default `game-dir`.
    game-dir: string,
}

export struct LauncherOptions {
    keep-open: bool,
    open-log: bool,
}

export global Store {
    in property <string> launcher-name;
    in property <string> launcher-version;
    // Baked packs; the first is the default.
    in property <[PackInfo]> packs;
    // Effective game directory of the selected installation, shortened.
    in property <string> game-dir;

    in-out property <Screen> screen: Screen.installing;
    in-out property <Page> page: Page.play;

    // Install progress; fraction < 0 means indeterminate.
    in property <string> stage;
    in property <string> detail;
    in property <float> fraction: -1;
    in property <string> error-message;
    // Log file to send to the admin; set only when the game crashed.
    in property <string> error-file;
    // Muted technical detail under the file, e.g. the exit status.
    in property <string> error-detail;
    in-out property <bool> error-open;

    in-out property <string> nick;
    in-out property <bool> nick-open;
    // Pixel face for the nick, regenerated by Rust when it changes.
    in property <image> avatar;
    in property <[Profile]> profiles;
    // Index into `profiles` of the installation Play starts; `profile` is
    // a copy of it.
    in property <int> selected;
    in property <Profile> profile;
    out property <PackInfo> pack: packs[profile.pack];
    // The edit page works on `draft`; `editing` is its index in
    // `profiles`, or -1 for a new installation.
    in-out property <int> editing;
    in-out property <Profile> draft;
    in-out property <LauncherOptions> options;
    in property <int> min-ram-gb: 4;
    in property <int> max-ram-gb: 16;

    // Switching installations would race the running install or game.
    out property <bool> can-switch: screen == Screen.ready || screen == Screen.error;

    pure callback nick-valid(string) -> bool;
    callback save-nick(string);
    callback save-profile(int, Profile);
    // Adds the installation, selects it and installs its pack.
    callback create-profile(Profile);
    callback delete-profile(int);
    // Selects the installation and installs its pack if needed.
    callback select-profile(int);
    callback save-options(LauncherOptions);
    callback retry();
    callback play();
    // Play, asking for a nick first if there is none yet.
    public function start-game() {
        if nick == "" {
            nick-open = true;
        } else {
            play();
        }
    }
    public function edit-installation(index: int) {
        editing = index;
        draft = profiles[index];
        page = Page.edit;
    }
    // Starts from the newest pack: the default one is installed already.
    public function new-installation() {
        editing = -1;
        draft = { pack: packs.length - 1, ram-gb: profile.ram-gb };
        page = Page.edit;
    }
    // Opens the game directory of the installation at `index`.
    callback open-game-dir(int);
    callback open-logs-dir();
}
