// The frame around every page: sidebar, page header with tabs, and the
// bottom bar holding the installation, Play button and account.

import { Theme, Icons } from "theme.slint";
import { Store, Screen, Page } from "store.slint";
import { Icon, Avatar, Button, ProgressBar } from "widgets.slint";

component SideItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> selected;
    callback clicked;

    height: 44px;
    border-radius: 3px;
    background: root.selected ? Theme.selected : touch.has-hover ? #2a2a2a : transparent;

    // Accent strip on the selected entry.
    if root.selected: Rectangle {
        x: 0;
        width: 3px;
        height: 60%;
        background: Theme.green-text;
    }

    HorizontalLayout {
        padding-left: 16px;
        spacing: 12px;
        Icon {
            outline: root.icon;
            color: root.selected ? Theme.text : Theme.text-muted;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.text-muted;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Sidebar inherits Rectangle {
    width: 216px;
    background: Theme.sidebar;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: #00000055;
    }

    VerticalLayout {
        // Account
        // As tall as the page header so the two dividers line up.
        account := Rectangle {
            height: 103px;
            background: account-touch.has-hover ? #252525 : transparent;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 14px;
                spacing: 10px;
                Avatar {
                    face: Store.avatar;
                    size: 40px;
                    y: (parent.height - self.height) / 2;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: Store.nick == "" ? "Set nickname" : Store.nick;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: "Offline account";
                        color: Theme.text-dim;
                        font-size: 12px;
                    }
                }
                Icon {
                    outline: Icons.pencil;
                    color: Theme.text-muted;
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                }
            }
            account-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { Store.nick-open = true; }
            }
        }

        // Same seam as the page header's bottom border.
        Rectangle {
            height: 1px;
            background: #00000060;
        }

        // The selected installation's pack.
        VerticalLayout {
            padding: 8px;
            Rectangle {
                height: 64px;
                border-radius: 3px;
                background: Store.page != Page.settings ? Theme.selected : game-touch.has-hover ? #2a2a2a : transparent;
                if Store.page != Page.settings: Rectangle {
                    x: 0;
                    width: 3px;
                    height: 60%;
                    background: Theme.green-text;
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 44px;
                        height: 44px;
                        y: (parent.height - self.height) / 2;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: Store.pack.name;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: "Minecraft " + Store.pack.minecraft;
                            color: Theme.text-dim;
                            font-size: 12px;
                        }
                    }
                }
                game-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if Store.page == Page.settings { Store.page = Page.play; }
                    }
                }
            }
        }

        Rectangle { }

        VerticalLayout {
            padding: 8px;
            spacing: 2px;
            SideItem {
                text: "Game folder";
                icon: Icons.folder;
                clicked => { Store.open-game-dir(Store.selected); }
            }
            SideItem {
                text: "Settings";
                icon: Icons.sliders;
                selected: Store.page == Page.settings;
                clicked => { Store.page = Page.settings; }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        HorizontalLayout {
            padding: 16px;
            spacing: 8px;
            Text {
                text: Store.launcher-name;
                color: Theme.text-muted;
                font-family: Theme.display-font;
                font-size: 14px;
                vertical-alignment: center;
            }
            Text {
                text: "v" + Store.launcher-version;
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }
}

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    // Label flush left so tabs share the title's left edge.
    min-width: label.preferred-width;
    label := Text {
        x: 0;
        y: 8px;
        text: root.text;
        color: root.active ? Theme.text : touch.has-hover ? Theme.text : Theme.text-muted;
        font-size: 14px;
        font-weight: root.active ? 700 : 600;
    }
    Rectangle {
        y: parent.height - self.height;
        height: 3px;
        x: 0;
        width: label.width;
        background: root.active ? Theme.green-text : transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Title strip above the page: tabs on the game pages, a note otherwise.
export component PageHeader inherits Rectangle {
    in property <string> title;
    in property <bool> tabs;
    in property <string> note;
    height: 104px;
    background: Theme.header;

    VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 22px;
        spacing: 10px;
        alignment: start;
        Text {
            text: root.title;
            color: Theme.text;
            font-family: Theme.display-font;
            font-size: 30px;
        }
        if root.tabs: HorizontalLayout {
            spacing: 28px;
            alignment: start;
            height: 34px;
            Tab {
                text: "Play";
                active: Store.page == Page.play;
                clicked => { Store.page = Page.play; }
            }
            Tab {
                text: "Installations";
                active: Store.page == Page.installations || Store.page == Page.edit;
                clicked => { Store.page = Page.installations; }
            }
        }
        if !root.tabs: Text {
            text: root.note;
            color: Theme.text-dim;
            font-size: 13px;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #00000060;
    }
}

// The big green button with the Minecraft-style pressed edge.
export component PlayButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> busy;
    callback clicked;

    property <bool> raised: root.enabled && !root.busy && !touch.pressed;

    width: 280px;
    height: 64px;
    border-radius: 2px;
    background: root.busy ? Theme.green.transparentize(0.7)
        : !root.enabled ? #3b4a37
        : touch.pressed ? Theme.green-pressed : touch.has-hover ? Theme.green-hover : Theme.green;
    animate background { duration: 100ms; }

    // Bevel: light top edge, dark bottom edge; both flatten when pressed.
    Rectangle {
        y: 0;
        height: root.raised ? 2px : 0px;
        background: #ffffff38;
        border-top-left-radius: 2px;
        border-top-right-radius: 2px;
    }
    Rectangle {
        y: parent.height - self.height;
        height: root.raised ? 5px : 0px;
        background: Theme.green-edge;
        border-bottom-left-radius: 2px;
        border-bottom-right-radius: 2px;
    }

    Text {
        y: (parent.height - self.height) / 2 - (root.raised ? 2px : 0px);
        text: root.text;
        color: root.busy ? #ffffffc0 : root.enabled ? white : #a5b3a0;
        font-family: Theme.display-font;
        font-size: 24px;
        letter-spacing: 1px;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Installation picker, Play button (or install progress) and account.
export component BottomBar inherits Rectangle {
    height: 92px;
    background: Theme.bar;

    Rectangle {
        y: 0;
        height: 1px;
        background: #ffffff12;
    }

    HorizontalLayout {
        // On the 32px content grid; equal sides keep PLAY centred.
        padding-left: 32px;
        padding-right: 32px;
        spacing: 24px;

        // Installation. Both side columns share the same fixed basis so the
        // centre slot sits exactly mid-bar whatever their content is.
        Rectangle {
            horizontal-stretch: 1;
            min-width: 240px;
            preferred-width: 0px;
            HorizontalLayout {
                alignment: start;
                padding-top: 16px;
                padding-bottom: 16px;
                // Inset so it reads as a control, not a label.
                Rectangle {
                    border-radius: 3px;
                    background: install-touch.has-hover ? #333333 : #282828;
                    border-width: 1px;
                    border-color: #ffffff14;
                    HorizontalLayout {
                        padding: 8px;
                        padding-right: 12px;
                        spacing: 12px;
                        Image {
                            source: @image-url("../assets/icon.png");
                            width: 44px;
                            height: 44px;
                            y: (parent.height - self.height) / 2;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: Store.profile.name;
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 700;
                                overflow: elide;
                                max-width: 180px;
                            }
                            Text {
                                text: "Manage installation";
                                color: Theme.text-dim;
                                font-size: 12px;
                            }
                        }
                        Icon {
                            outline: Icons.chevron-right;
                            color: Theme.text;
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    install-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Store.page = Page.installations; }
                    }
                }
            }
        }

        // Center: progress while installing, otherwise the Play button.
        Rectangle {
            width: 280px;
            if Store.screen == Screen.installing: VerticalLayout {
                alignment: center;
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        text: Store.stage;
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: Store.fraction < 0 ? "" : round(Store.fraction * 100) + "%";
                        color: Theme.green-text;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: right;
                    }
                }
                ProgressBar {
                    fraction: Store.fraction;
                    indeterminate: Store.fraction < 0;
                }
                Text {
                    text: Store.detail == "" ? "The first start downloads a few gigabytes" : Store.detail;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            if Store.screen != Screen.installing: PlayButton {
                text: Store.screen == Screen.running ? "PLAYING" : Store.screen == Screen.error ? "RETRY" : "PLAY";
                // Reads "busy" rather than "disabled" while the game runs.
                busy: Store.screen == Screen.running;
                enabled: Store.screen != Screen.running;
                clicked => {
                    if Store.screen == Screen.error { Store.retry(); } else { Store.start-game(); }
                }
            }
        }

        // Account
        Rectangle {
            horizontal-stretch: 1;
            min-width: 240px;
            preferred-width: 0px;
            HorizontalLayout {
                alignment: end;
                Rectangle {
                    border-radius: 3px;
                    background: nick-touch.has-hover ? #2c2c2c : transparent;
                    HorizontalLayout {
                        // No right padding: the name ends on the 32px inset.
                        padding: 8px;
                        padding-right: 0px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: Store.nick == "" ? "Set nickname" : Store.nick;
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-alignment: right;
                            }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 6px;
                                if Store.screen == Screen.running: Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: Theme.green-text;
                                }
                                Text {
                                    text: Store.screen == Screen.running ? "In game" : "Offline account";
                                    color: Store.screen == Screen.running ? Theme.green-text : Theme.text-dim;
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                    nick-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Store.nick-open = true; }
                    }
                }
            }
        }
    }
}
