// The launcher window, laid out like the official Minecraft launcher:
// sidebar on the left, page header with tabs, page body, bottom Play bar.

import { Theme } from "theme.slint";
import { Store, Screen, Page, Profile, LauncherOptions } from "store.slint";
import { Sidebar, PageHeader, BottomBar } from "chrome.slint";
import { PlayPage, InstallationsPage, EditPage, SettingsPage } from "pages.slint";
import { NickDialog, ErrorDialog } from "dialogs.slint";

export { Store, Screen, Page, Profile, LauncherOptions }

export component AppWindow inherits Window {
    title: Store.launcher-name;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1120px;
    preferred-height: 700px;
    min-width: 940px;
    min-height: 600px;
    background: Theme.content;
    default-font-family: Theme.font;

    HorizontalLayout {
        Sidebar { }
        VerticalLayout {
            PageHeader {
                title: Store.page == Page.settings ? "LAUNCHER SETTINGS" : Store.pack-subtitle.to-uppercase();
                tabs: Store.page != Page.settings;
                note: "Changes are saved automatically";
            }
            if Store.page == Page.play: PlayPage { }
            if Store.page == Page.installations: InstallationsPage { }
            if Store.page == Page.edit: EditPage { }
            if Store.page == Page.settings: SettingsPage { }
            // Like the official launcher, only the Play tab has the Play bar.
            if Store.page == Page.play: BottomBar { }
        }
    }

    if Store.nick-open: NickDialog { }
    if Store.error-open: ErrorDialog { }
}
